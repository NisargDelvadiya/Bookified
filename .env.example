# ==============================================================================
# ENVIRONMENT CONFIGURATION FOR BOOKIFIED
# ==============================================================================

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# CLERK AUTHENTICATION (https://clerk.com)
# Create an application in Clerk dashboard and copy your API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# MONGODB DATABASE (https://mongodb.com)
# MongoDB connection URI (e.g. MongoDB Atlas cluster)
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bookified?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# VERCEL BLOB STORAGE (https://vercel.com/dashboard/stores)
# Create a Blob store in your Vercel project and copy the Read-Write token
# ------------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ------------------------------------------------------------------------------
# VAPI VOICE AI (https://vapi.ai)
# Public API key and Assistant ID for Voice Conversations
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPI_API_KEY=...
NEXT_PUBLIC_ASSISTANT_ID=...
VAPI_SERVER_SECRET=...

# ------------------------------------------------------------------------------
# ELEVENLABS (https://elevenlabs.io) [Optional/Future Voice Customization]
# ------------------------------------------------------------------------------
ELEVENLABS_API_KEY=...
